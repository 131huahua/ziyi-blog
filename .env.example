# ============ AI 食谱助手 / 文章 AI 编辑（可选，不配则功能禁用） ============
# 对话模型（OpenAI 兼容格式），默认硅基流动（一个 key 同时给对话和向量用）
CHAT_API_KEY=
CHAT_BASE_URL=https://api.siliconflow.cn/v1
CHAT_MODEL=deepseek-ai/DeepSeek-V4-Flash

# 向量模型（embedding，硅基流动 bge-m3 免费）
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# ============ AI 接口配额（防滥用/防烧钱） ============
# API Token：逗号分隔多个；访客带 Authorization: Bearer <token> 调用可获更高配额
AI_API_TOKENS=
# 匿名限流：每 IP 10 分钟次数 / 每天次数
AI_LIMIT_PER_10MIN=3
AI_LIMIT_PER_DAY=20
# Token 限流：每天次数
AI_TOKEN_LIMIT_PER_DAY=500
