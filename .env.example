# ============ AI 食谱助手 / 文章 AI 编辑（可选，不配则功能禁用） ============

# 对话模型（OpenAI 兼容格式，任选一家）
# DeepSeek:  https://api.deepseek.com/v1  模型 deepseek-chat
# 硅基流动:  https://api.siliconflow.cn/v1  模型 deepseek-ai/DeepSeek-V3
# NVIDIA:    https://integrate.api.nvidia.com/v1  模型 deepseek-ai/deepseek-v4-flash-0731
CHAT_API_KEY=
CHAT_BASE_URL=https://api.deepseek.com/v1
CHAT_MODEL=deepseek-chat
TEMPERATURE=0.4
MAX_TOKENS=2000

# 向量模型：默认本地 fastembed（离线免费，首次运行自动下载 BAAI/bge-small-zh-v1.5，
# 国内网络自动走 hf-mirror 镜像，无需任何 key）
# 如想改用 API 向量：EMBEDDING_PROVIDER=api 并填下面三项
EMBEDDING_PROVIDER=local
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# 记忆（可选，有默认值）
# MEMORY_DB_PATH=./memory.db
# HISTORY_LIMIT=8   # 带进上下文的最近对话轮数

# ============ AI 接口防护（防滥用/防烧钱/防爬 sk-） ============
# API Token：逗号分隔多个；访客带 Authorization: Bearer <token> 调用可获更高配额
AI_API_TOKENS=
# 匿名限流：每 IP 30 分钟次数 / 每天次数 / 窗口秒数(默认1800=30分钟)
AI_LIMIT_PER_WIN=3
AI_LIMIT_PER_DAY=10
AI_LIMIT_WIN_SECONDS=1800
# Token 限流：每天次数
AI_TOKEN_LIMIT_PER_DAY=20
# 其他防护：问题最大长度 / 单 IP 并发上限
AI_MAX_QUESTION_LEN=200
AI_MAX_CONCURRENT=2
